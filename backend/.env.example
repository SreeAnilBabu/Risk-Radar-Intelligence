# ─── RiskRadar backend env ───────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.

# Data source: "passport" pulls from Passport SQL Server, anything else
# (or unset) falls back to the bundled JSON fixtures in src/data/*.json.
RISKRADAR_DATA_SOURCE=mock

# ─── Passport SQL Server connection (only used when DATA_SOURCE=passport)
PASSPORT_DB_HOST=localhost
PASSPORT_DB_PORT=1433
PASSPORT_DB_NAME=passport
PASSPORT_DB_USER=sa
PASSPORT_DB_PASSWORD=changeme
# Set to "true" if your SQL Server requires TLS (Azure SQL = true).
PASSPORT_DB_ENCRYPT=false
# Set to "true" to trust self-signed dev certificates.
PASSPORT_DB_TRUST_SERVER_CERT=true

# Optional: HTTP port for the API server.
PORT=3010
